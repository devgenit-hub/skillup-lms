{
  "name": "skill-up",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:website": "turbo run build --filter=website",
    "build:dashboard": "turbo run build --filter=dashboard",
    "dev": "turbo run dev",
    "dev:frontend": "turbo run dev --filter=website --filter=dashboard",
    "docker:api": "cd packages/api && ./scripts/run-local.sh",
    "docker:api:rebuild": "cd packages/api && ./scripts/run-local.sh --rebuild",
    "deploy:api": "cd packages/api && ./scripts/deploy.sh",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "prepare": "husky",
    "postinstall": "pnpm run generate:locales",
    "generate": "pnpm run generate:db && pnpm run generate:locales",
    "generate:db": "pnpm --filter @repo/db generate",
    "generate:locales": "pnpm --filter @repo/locales generate",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:migrate:deploy": "pnpm --filter @repo/db db:migrate:deploy",
    "db:seed": "pnpm --filter @repo/db db:seed",
    "db:studio": "pnpm --filter @repo/db db:studio",
    "db:push": "pnpm --filter @repo/db db:push"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "eslint": "^9.39.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "turbo": "^2.6.0",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.40.0"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
