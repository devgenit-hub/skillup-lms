generator client {
 provider = "prisma-client-js"
}

datasource db {
 provider = "postgresql"
}

model User {
 id               String       @id @default(cuid())
 supabaseId       String       @unique
 email            String       @unique
 name             String?
 avatarUrl        String?
 phone            String?
 emailVerified    Boolean      @default(false)
 provider         AuthProvider @default(EMAIL)
 role             UserRole     @default(STUDENT)
 suspended        Boolean      @default(false)
 suspendedAt      DateTime?
 suspendedBy      String?
 suspensionReason String?
 lastLoginAt      DateTime?
 createdAt        DateTime     @default(now())
 updatedAt        DateTime     @updatedAt

 enrollments          Enrollment[]
 payments             Payment[]
 webinarRegistrations WebinarRegistration[]

 @@index([supabaseId])
 @@index([email])
 @@index([suspended])
 @@index([createdAt])
 @@index([role])
 @@map("users")
}

model Teacher {
 id             String    @id @default(cuid())
 supabaseId     String    @unique
 name           String
 email          String    @unique
 phone          String?
 address        String?
 qualification  String?
 experience     Int?
 specialization String?
 bio            String?
 profileImage   String?
 joiningDate    DateTime?
 createdAt      DateTime  @default(now())
 updatedAt      DateTime  @updatedAt

 courseTeachers CourseTeacher[]

 @@index([supabaseId])
 @@index([email])
 @@map("teachers")
}

enum UserRole {
 STUDENT
 INSTRUCTOR
 ADMIN
}

enum AuthProvider {
 EMAIL
 GOOGLE
}

enum FeeType {
 FREE
 PAID
}

model Category {
 id           String   @id @default(cuid())
 title        String   @unique
 slug         String   @unique
 courseCount  Int      @default(0)
 webinarCount Int      @default(0)
 createdAt    DateTime @default(now())
 updatedAt    DateTime @updatedAt

 courses  Course[]
 webinars Webinar[]

 @@index([slug])
 @@map("categories")
}

model Course {
 id             String   @id @default(cuid())
 title          String
 description    String?
 published      Boolean  @default(false)
 introVideoLink String?
 feeType        FeeType  @default(FREE)
 price          Float?
 categoryId     String?
 metadata       Json?
 createdAt      DateTime @default(now())
 updatedAt      DateTime @updatedAt

 category          Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
 enrollments       Enrollment[]
 lessons           Lesson[]
 courseTeachers    CourseTeacher[]
 coupons           Coupon[]
 curriculumModules CurriculumModule[]

 @@index([published])
 @@index([feeType])
 @@index([categoryId])
 @@map("courses")
}

model Lesson {
 id        String   @id @default(cuid())
 title     String
 content   String?
 order     Int
 published Boolean  @default(false)
 courseId  String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

 @@index([courseId])
 @@map("lessons")
}

model Enrollment {
 id          String           @id @default(cuid())
 userId      String
 courseId    String
 status      EnrollmentStatus @default(ACTIVE)
 progress    Int              @default(0)
 enrolledAt  DateTime         @default(now())
 completedAt DateTime?
 updatedAt   DateTime         @updatedAt

 user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
 course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

 @@unique([userId, courseId])
 @@index([userId])
 @@index([courseId])
 @@map("enrollments")
}

enum EnrollmentStatus {
 ACTIVE
 COMPLETED
 DROPPED
}

model Payment {
 id                   String        @id @default(cuid())
 userId               String
 courseId             String?
 webinarId            String?
 amount               Float
 chargedAmount        Float?
 fee                  Float?
 status               PaymentStatus @default(PENDING)
 transactionId        String?       @unique
 invoiceId            String?       @unique
 gatewayTransactionId String?       @unique
 paymentMethod        String        @default("uddoktapay")
 senderNumber         String?
 couponCode           String?
 paidAt               DateTime?
 refundedAt           DateTime?
 refundAmount         Float?
 refundReason         String?
 metadata             Json?
 createdAt            DateTime      @default(now())
 updatedAt            DateTime      @updatedAt

 user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 webinar Webinar? @relation(fields: [webinarId], references: [id], onDelete: Cascade)

 @@index([userId])
 @@index([courseId])
 @@index([webinarId])
 @@index([transactionId])
 @@index([invoiceId])
 @@index([gatewayTransactionId])
 @@index([status])
 @@map("payments")
}

enum PaymentStatus {
 PENDING
 COMPLETED
 FAILED
 REFUNDED
 CANCELLED
}

model Webinar {
 id                String   @id @default(cuid())
 title             String
 categoryId        String?
 image             String?
 scheduleDateTime  DateTime
 duration          Int
 feeType           String   @default("free")
 price             Float?
 platform          String
 status            String   @default("draft")
 sessionHighlights String?  @db.Text
 aboutWebinar      String?  @db.Text
 speakers          Json?
 sessionAgenda     Json?
 resources         Json?
 liveLink          String?
 createdAt         DateTime @default(now())
 updatedAt         DateTime @updatedAt

 category      Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
 registrations WebinarRegistration[]
 coupons       Coupon[]
 payments      Payment[]

 @@index([status])
 @@index([scheduleDateTime])
 @@index([categoryId])
 @@map("webinars")
}

model WebinarRegistration {
 id           String   @id @default(cuid())
 webinarId    String
 userId       String
 registeredAt DateTime @default(now())

 user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
 webinar Webinar @relation(fields: [webinarId], references: [id], onDelete: Cascade)

 @@unique([webinarId, userId])
 @@index([webinarId])
 @@index([userId])
 @@map("webinar_registrations")
}

model CourseTeacher {
 id        String   @id @default(cuid())
 courseId  String
 teacherId String
 createdAt DateTime @default(now())

 course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
 teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

 @@unique([courseId, teacherId])
 @@index([courseId])
 @@index([teacherId])
 @@map("course_teachers")
}

model Coupon {
 id         String   @id @default(cuid())
 code       String   @unique
 title      String?
 courseId   String?
 webinarId  String?
 discount   Int
 expiresAt  DateTime
 usageCount Int      @default(0)
 maxUsage   Int?
 active     Boolean  @default(true)
 createdAt  DateTime @default(now())
 updatedAt  DateTime @updatedAt

 course  Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
 webinar Webinar? @relation(fields: [webinarId], references: [id], onDelete: Cascade)

 @@index([courseId])
 @@index([webinarId])
 @@index([code])
 @@index([expiresAt])
 @@map("coupons")
}

model CurriculumModule {
 id        String   @id @default(cuid())
 title     String
 details   String?  @db.Text
 order     Int      @default(0)
 courseId  String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 course    Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
 classes   CurriculumClass[]
 materials CurriculumMaterial[]

 @@index([courseId])
 @@index([order])
 @@map("curriculum_modules")
}

model CurriculumClass {
 id        String   @id @default(cuid())
 title     String
 videoUrl  String?
 duration  Int?
 order     Int      @default(0)
 moduleId  String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 module CurriculumModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

 @@index([moduleId])
 @@index([order])
 @@map("curriculum_classes")
}

model CurriculumMaterial {
 id        String   @id @default(cuid())
 title     String
 fileUrl   String?
 fileType  String?
 fileSize  Int?
 order     Int      @default(0)
 moduleId  String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 module CurriculumModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

 @@index([moduleId])
 @@index([order])
 @@map("curriculum_materials")
}
