# ===========================================
# LOCAL DEVELOPMENT
# ===========================================

# Database Connection (Local PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/skillup?schema=public"

# API Server
PORT=4000
NODE_ENV=development

# CORS (Frontend URLs)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# ===========================================
# PRODUCTION (Render + Supabase)
# ===========================================

# Supabase Database URLs
# Get these from: Supabase Dashboard → Project Settings → Database → Connection String

# Connection Pooling (use this for DATABASE_URL on Render)
# DATABASE_URL="postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection (use this for DATABASE_DIRECT_URL on Render for migrations)
# DATABASE_DIRECT_URL="postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# API Server (Production)
# PORT=10000
# NODE_ENV=production

# CORS (Production Frontend URLs - add your Vercel URLs)
# ALLOWED_ORIGINS="https://skillup-website.vercel.app,https://skillup-dashboard.vercel.app"
